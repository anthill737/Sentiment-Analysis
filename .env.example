# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#
# APP_PASSWORD: the password you use to sign in to the SA Runner web UI.
# Pick anything reasonably strong; the app only listens on 127.0.0.1 so this is
# mostly a local-only single-user credential.
APP_PASSWORD=replace-with-your-password

# SESSION_SECRET: 32 bytes of hex used to sign session cookies. Generate a fresh value:
#   PowerShell:  [System.BitConverter]::ToString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).Replace("-","").ToLower()
#   macOS/Linux: openssl rand -hex 32
SESSION_SECRET=replace-with-32-bytes-of-hex
