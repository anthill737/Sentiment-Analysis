# ── Secrets & keys (defense-in-depth) ────────────────────────────────────────
# The runtime stores all secrets in %LOCALAPPDATA%\sa-runner\ so these patterns
# guard against accidental copies into the project tree.
*.key
*.pem
*.p12
.env
.env.local
.env.development
.env.development.local
.env.production
.env.production.local
.env.test
.env.test.local
.env.*
!.env.example
master.key
secrets.json
api_keys.json

# ── Runtime data (never check in user data) ──────────────────────────────────
*.db
*.db-journal
*.db-wal
*.db-shm
sa_runner.db
runs/
logs/

# ── Skill run outputs (defense-in-depth) ─────────────────────────────────────
# Real runs go to %LOCALAPPDATA%\sa-runner\runs\, but if anyone runs the skill
# from inside the project tree (e.g., during development or in a sandbox), the
# generated reports, charts, and intermediate JSON must NEVER end up in a
# commit. These patterns cover the common landing spots.
#
# IMPORTANT: tests/fixtures/skill_outputs/ is intentionally tracked — it holds
# canonical fixtures used by the test suite. Do not exclude that directory.
test/run/
test/**/run/
**/sentiment-analysis/test/
**/sentiment-analysis/output/
sentiment-analysis/test/
sentiment-analysis/output/
output/
out/
.scratch/

# Loose generated reports anywhere in the tree (allow-list tests/fixtures)
report.pdf
report.docx
executive.json
scores.json
themes.json
synthesis.json
plan.json
evidence.json
!tests/fixtures/**/report.pdf
!tests/fixtures/**/report.docx
!tests/fixtures/**/executive.json
!tests/fixtures/**/scores.json
!tests/fixtures/**/themes.json
!tests/fixtures/**/synthesis.json
!tests/fixtures/**/plan.json
!tests/fixtures/**/evidence.json

# Chart PNGs generated by the skill — these are the main bulk-bloat risk
**/charts/*.png
!tests/fixtures/**/charts/*.png
!frontend/**/charts/*.png

# ── Generated artifacts ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/
!frontend/dist/

# ── Sample / example artifacts ───────────────────────────────────────────────
# Sample reports and synthesis outputs from past runs that shouldn't ship
# with the source. Real reports live in %LOCALAPPDATA%\sa-runner\runs\.
example_*.pdf
example_*.docx
example_*.json
sample_*.pdf
sample_*.docx
sample_*.json

# ── Frontend ─────────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/test-results/
frontend/.vite/
frontend/playwright-report/

# ── Editor / OS noise ────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# ── Local dev/test scratch ───────────────────────────────────────────────────
.devteam/
scratch/
TODO.local.md
NOTES.local.md

# ── Large file guard ─────────────────────────────────────────────────────────
# Common archive/binary types that should almost never appear in source.
# If you genuinely need one tracked, add a `!path/to/file` exception above.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.parquet
*.pkl
*.pickle
*.h5
*.hdf5
*.sqlite
*.sqlite3
